{
  "name": "docs-mcp",
  "version": "2.0.0",
  "transport": {
    "type": "http",
    "host": "127.0.0.1",
    "port": 8443,
    "tls": true,
    "auth": {"type": "oauth2", "pkce": true, "state": true},
    "allowed_origins": ["https://studio.cognis.digital"]
  },
  "capabilities": {"tools": {}},
  "tools": [
    {
      "name": "search_docs",
      "description": "Search the internal documentation corpus and return matching passages.",
      "inputSchema": {
        "type": "object",
        "properties": {"query": {"type": "string"}},
        "required": ["query"],
        "additionalProperties": false
      }
    },
    {
      "name": "fetch_doc",
      "description": "Fetch a single document by its stable identifier.",
      "inputSchema": {
        "type": "object",
        "properties": {"id": {"type": "string"}},
        "required": ["id"],
        "additionalProperties": false
      }
    }
  ]
}
